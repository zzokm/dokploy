{
	"name": "dokploy",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"dokploy:setup": "pnpm --filter=dokploy run setup",
		"dokploy:setup:with-data-plane": "pnpm dokploy:setup && pnpm core-services:up:mail",
		"dokploy:dev": "pnpm --filter=dokploy run dev",
		"dokploy:dev:data-plane": "pnpm core-services:up:mail && pnpm dokploy:dev",
		"dokploy:build": "pnpm --filter=dokploy run build",
		"dokploy:start": "pnpm --filter=dokploy run start",
		"test": "pnpm --filter=dokploy run test",
		"server:script": "pnpm --filter=server run switch:dev",
		"server:dev": "pnpm --filter=server run dev",
		"server:build": "pnpm --filter=server run build",
		"docker:build:canary": "./apps/dokploy/docker/build.sh canary",
		"typecheck": "pnpm -r run typecheck",
		"build": "pnpm -r run build",
		"format-and-lint": "biome check .",
		"check": "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true",
		"format-and-lint:fix": "biome check . --write",
		"generate:openapi": "pnpm --filter=dokploy run generate:openapi",
		"core-services:init": "node scripts/core-services-init.mjs",
		"core-services:up": "node scripts/core-services-init.mjs && docker compose -f docker/core-services/docker-compose.yml up -d",
		"core-services:up:mail": "node scripts/core-services-init.mjs && docker compose -f docker/core-services/docker-compose.yml --profile mail up -d",
		"core-services:down": "docker compose -f docker/core-services/docker-compose.yml --profile mail down",
		"core-services:logs:bind": "docker compose -f docker/core-services/docker-compose.yml logs -f core-services-bind"
	},
	"devDependencies": {
		"@biomejs/biome": "2.1.1",
		"@types/node": "^24.4.0",
		"dotenv": "16.4.5",
		"esbuild": "0.20.2",
		"lint-staged": "^15.5.2",
		"tsx": "4.16.2"
	},
	"packageManager": "pnpm@10.22.0",
	"engines": {
		"node": "^24.4.0",
		"pnpm": ">=9.12.0"
	},
	"lint-staged": {
		"*": [
			"biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
		]
	},
	"resolutions": {
		"@types/react": "18.3.5",
		"@types/react-dom": "18.3.0"
	},
	"pnpm": {
		"overrides": {
			"esbuild": "0.20.2"
		},
		"onlyBuiltDependencies": [
			"@scarf/scarf",
			"@tree-sitter-grammars/tree-sitter-yaml",
			"bcrypt",
			"better-sqlite3",
			"core-js-pure",
			"cpu-features",
			"esbuild",
			"msgpackr-extract",
			"node-pty",
			"protobufjs",
			"sharp",
			"ssh2",
			"tree-sitter",
			"tree-sitter-json",
			"@prisma/engines",
			"prisma"
		]
	}
}
