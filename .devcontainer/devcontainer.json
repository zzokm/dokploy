{
	"name": "Dokploy development container",
	"build": {
		"dockerfile": "Dockerfile",
		"context": ".."
	},
	"features": {
		"ghcr.io/devcontainers/features/docker-in-docker:2": {
			"moby": true,
			"version": "latest"
		},
		"ghcr.io/devcontainers/features/git:1": {
			"ppa": true,
			"version": "latest"
		},
		"ghcr.io/devcontainers/features/go:1": {
			"version": "1.20"
		}
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-vscode.vscode-typescript-next",
				"bradlc.vscode-tailwindcss",
				"ms-vscode.vscode-json",
				"biomejs.biome",
				"golang.go",
				"redhat.vscode-xml",
				"github.vscode-github-actions",
				"github.copilot",
				"github.copilot-chat"
			]
		}
	},
	"forwardPorts": [
		3000,
		5432,
		6379,
		3025,
		3587,
		3465,
		3143,
		3993,
		3080
	],
	"portsAttributes": {
		"3000": {
			"label": "Dokploy App",
			"onAutoForward": "notify"
		},
		"5432": {
			"label": "PostgreSQL",
			"onAutoForward": "silent"
		},
		"6379": {
			"label": "Redis",
			"onAutoForward": "silent"
		},
		"3080": {
			"label": "Panel Roundcube (mail profile)",
			"onAutoForward": "silent"
		},
		"3025": {
			"label": "Panel DMS SMTP 25 (mail profile)",
			"onAutoForward": "silent"
		},
		"3587": {
			"label": "Panel DMS submission 587 (mail profile)",
			"onAutoForward": "silent"
		},
		"3465": {
			"label": "Panel DMS SMTPS 465 (mail profile)",
			"onAutoForward": "silent"
		},
		"3143": {
			"label": "Panel DMS IMAP 143 (mail profile)",
			"onAutoForward": "silent"
		},
		"3993": {
			"label": "Panel DMS IMAPS 993 (mail profile)",
			"onAutoForward": "silent"
		}
	},
	"postStartCommand": "pnpm core-services:up:mail",
	"remoteUser": "node",
	"workspaceFolder": "/workspaces/dokploy",
	"runArgs": ["--name", "dokploy-devcontainer"]
}
