{
	"version": "2.0.0",
	"options": {
		"cwd": "${workspaceFolder}",
		"env": {
			"NODE_OPTIONS": "--use-system-ca"
		}
	},
	"tasks": [
		{
			"label": "Dokploy: Setup",
			"type": "shell",
			"command": "corepack pnpm run dokploy:setup",
			"presentation": {
				"reveal": "always",
				"panel": "shared",
				"showReuseMessage": false
			},
			"group": "build",
			"problemMatcher": []
		},
		{
			"label": "Dokploy: Dev server",
			"type": "shell",
			"command": "corepack pnpm run dokploy:dev",
			"isBackground": true,
			"presentation": {
				"reveal": "always",
				"panel": "dedicated",
				"focus": true,
				"showReuseMessage": false
			},
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": {
				"owner": "dokploy-dev",
				"pattern": {
					"regexp": "^$"
				},
				"background": {
					"activeOnStart": true,
					"beginsPattern": ".",
					"endsPattern": "Server Started on:"
				}
			}
		},
		{
			"label": "Dokploy: Build",
			"type": "shell",
			"command": "corepack pnpm run dokploy:build",
			"presentation": {
				"reveal": "always",
				"panel": "shared",
				"showReuseMessage": false
			},
			"group": "build",
			"problemMatcher": []
		},
		{
			"label": "Dokploy: Start",
			"type": "shell",
			"command": "corepack pnpm run dokploy:start",
			"presentation": {
				"reveal": "always",
				"panel": "shared",
				"showReuseMessage": false
			},
			"group": "build",
			"problemMatcher": []
		},
		{
			"label": "Dokploy: Test",
			"type": "shell",
			"command": "corepack pnpm run test",
			"presentation": {
				"reveal": "always",
				"panel": "shared",
				"showReuseMessage": false
			},
			"group": "test",
			"problemMatcher": []
		},
		{
			"label": "Dokploy: Typecheck",
			"type": "shell",
			"command": "corepack pnpm run typecheck",
			"presentation": {
				"reveal": "always",
				"panel": "shared",
				"showReuseMessage": false
			},
			"group": "test",
			"problemMatcher": []
		},
		{
			"label": "Dokploy: Generate OpenAPI",
			"type": "shell",
			"command": "corepack pnpm run generate:openapi",
			"presentation": {
				"reveal": "always",
				"panel": "shared",
				"showReuseMessage": false
			},
			"problemMatcher": []
		},
		{
			"label": "Server: Switch to src/dev exports",
			"type": "shell",
			"command": "corepack pnpm run server:script",
			"presentation": {
				"reveal": "always",
				"panel": "shared",
				"showReuseMessage": false
			},
			"problemMatcher": []
		},
		{
			"label": "Server: Build",
			"type": "shell",
			"command": "corepack pnpm run server:build",
			"presentation": {
				"reveal": "always",
				"panel": "shared",
				"showReuseMessage": false
			},
			"problemMatcher": []
		}
	]
}
