{
	"version": "2.0.0",
	"options": {
		"cwd": "${workspaceFolder}",
		"env": {
			"NODE_OPTIONS": "--use-system-ca"
		}
	},
	"tasks": [
		{
			"label": "Dokploy: Install dependencies",
			"type": "shell",
			"command": "corepack pnpm install",
			"presentation": {
				"reveal": "always",
				"panel": "shared",
				"showReuseMessage": false
			},
			"group": "none",
			"problemMatcher": []
		},
		{
			"label": "Dokploy: Setup",
			"type": "shell",
			"command": "corepack pnpm --filter=dokploy exec tsx -r dotenv/config setup.ts; if ($?) { node -e \"setTimeout(function(){process.exit(0)},5000)\" }; if ($?) { corepack pnpm --filter=dokploy exec tsx -r dotenv/config migration.ts }",
			"presentation": {
				"reveal": "always",
				"panel": "shared",
				"showReuseMessage": false
			},
			"group": "build",
			"problemMatcher": []
		},
		{
			"label": "Dokploy: Ensure Postgres",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				".\\.vscode\\ensure-postgres.ps1"
			],
			"presentation": {
				"reveal": "silent",
				"panel": "shared",
				"showReuseMessage": false,
				"close": true
			},
			"group": "none",
			"problemMatcher": []
		},
		{
			"label": "Dokploy: Dev server",
			"type": "shell",
			"command": "corepack pnpm --filter=dokploy run dev",
			"isBackground": true,
			"presentation": {
				"reveal": "always",
				"panel": "dedicated",
				"focus": true,
				"showReuseMessage": false
			},
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": {
				"owner": "dokploy-dev",
				"pattern": {
					"regexp": "^$"
				},
				"background": {
					"activeOnStart": true,
					"beginsPattern": ".",
					"endsPattern": "Server Started on:"
				}
			}
		},
		{
			"label": "Dokploy: Build",
			"type": "shell",
			"command": "corepack pnpm --filter=dokploy run build",
			"presentation": {
				"reveal": "always",
				"panel": "shared",
				"showReuseMessage": false
			},
			"group": "build",
			"problemMatcher": []
		},
		{
			"label": "Dokploy: Start",
			"type": "shell",
			"command": "corepack pnpm --filter=dokploy run start",
			"presentation": {
				"reveal": "always",
				"panel": "shared",
				"showReuseMessage": false
			},
			"group": "build",
			"problemMatcher": []
		},
		{
			"label": "Dokploy: Test",
			"type": "shell",
			"command": "corepack pnpm --filter=dokploy run test",
			"presentation": {
				"reveal": "always",
				"panel": "shared",
				"showReuseMessage": false
			},
			"group": "test",
			"problemMatcher": []
		},
		{
			"label": "Dokploy: Typecheck",
			"type": "shell",
			"command": "corepack pnpm -r run typecheck",
			"presentation": {
				"reveal": "always",
				"panel": "shared",
				"showReuseMessage": false
			},
			"group": "test",
			"problemMatcher": []
		},
		{
			"label": "Dokploy: Generate OpenAPI",
			"type": "shell",
			"command": "corepack pnpm --filter=dokploy run generate:openapi",
			"presentation": {
				"reveal": "always",
				"panel": "shared",
				"showReuseMessage": false
			},
			"problemMatcher": []
		},
		{
			"label": "Server: Switch to src/dev exports",
			"type": "shell",
			"command": "corepack pnpm --filter=server run switch:dev",
			"presentation": {
				"reveal": "always",
				"panel": "shared",
				"showReuseMessage": false
			},
			"group": "build",
			"problemMatcher": []
		},
		{
			"label": "Server: Build",
			"type": "shell",
			"command": "corepack pnpm --filter=server run build",
			"presentation": {
				"reveal": "always",
				"panel": "shared",
				"showReuseMessage": false
			},
			"group": "build",
			"problemMatcher": []
		},
		{
			"label": "Dokploy: Full stack (setup → switch → dev)",
			"dependsOn": [
				"Dokploy: Setup",
				"Server: Switch to src/dev exports",
				"Dokploy: Dev server"
			],
			"dependsOrder": "sequence",
			"group": "build",
			"problemMatcher": []
		}
	]
}
